<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Semi-transparent background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
        </shape>
    </item>

    <!-- Transparent center rectangle to show the target area -->
    <item android:gravity="center">
        <shape android:shape="rectangle">
            <size
                android:width="250dp"
                android:height="80dp" />
            <!-- Border for the scanning area -->
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" />
            <solid android:color="#00000000" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <!-- Scanner animation lines (top-left corner) -->
    <item android:gravity="center"
        android:top="-125dp"
        android:left="-105dp">
        <rotate
            android:fromDegrees="0"
            android:toDegrees="0">
            <shape android:shape="line">
                <stroke
                    android:width="2dp"
                    android:color="#4CAF50" />
                <size
                    android:width="20dp"
                    android:height="1dp" />
            </shape>
        </rotate>
    </item>

    <item android:gravity="center"
        android:top="-115dp"
        android:left="-125dp">
        <rotate
            android:fromDegrees="90"
            android:toDegrees="90">
            <shape android:shape="line">
                <stroke
                    android:width="2dp"
                    android:color="#4CAF50" />
                <size
                    android:width="20dp"
                    android:height="1dp" />
            </shape>
        </rotate>
    </item>

    <!-- Scanner animation lines (top-right corner) -->
    <item android:gravity="center"
        android:top="-125dp"
        android:right="-105dp">
        <rotate
            android:fromDegrees="0"
            android:toDegrees="0">
            <shape android:shape="line">
                <stroke
                    android:width="2dp"
                    android:color="#4CAF50" />
                <size
                    android:width="20dp"
                    android:height="1dp" />
            </shape>
        </rotate>
    </item>

    <item android:gravity="center"
        android:top="-115dp"
        android:right="-125dp">
        <rotate
            android:fromDegrees="-90"
            android:toDegrees="-90">
            <shape android:shape="line">
                <stroke
                    android:width="2dp"
                    android:color="#4CAF50" />
                <size
                    android:width="20dp"
                    android:height="1dp" />
            </shape>
        </rotate>
    </item>

    <!-- Scanner animation lines (bottom-left corner) -->
    <item android:gravity="center"
        android:bottom="-125dp"
        android:left="-105dp">
        <rotate
            android:fromDegrees="0"
            android:toDegrees="0">
            <shape android:shape="line">
                <stroke
                    android:width="2dp"
                    android:color="#4CAF50" />
                <size
                    android:width="20dp"
                    android:height="1dp" />
            </shape>
        </rotate>
    </item>

    <item android:gravity="center"
        android:bottom="-115dp"
        android:left="-125dp">
        <rotate
            android:fromDegrees="-90"
            android:toDegrees="-90">
            <shape android:shape="line">
                <stroke
                    android:width="2dp"
                    android:color="#4CAF50" />
                <size
                    android:width="20dp"
                    android:height="1dp" />
            </shape>
        </rotate>
    </item>

    <!-- Scanner animation lines (bottom-right corner) -->
    <item android:gravity="center"
        android:bottom="-125dp"
        android:right="-105dp">
        <rotate
            android:fromDegrees="0"
            android:toDegrees="0">
            <shape android:shape="line">
                <stroke
                    android:width="2dp"
                    android:color="#4CAF50" />
                <size
                    android:width="20dp"
                    android:height="1dp" />
            </shape>
        </rotate>
    </item>

    <item android:gravity="center"
        android:bottom="-115dp"
        android:right="-125dp">
        <rotate
            android:fromDegrees="90"
            android:toDegrees="90">
            <shape android:shape="line">
                <stroke
                    android:width="2dp"
                    android:color="#4CAF50" />
                <size
                    android:width="20dp"
                    android:height="1dp" />
            </shape>
        </rotate>
    </item>
</layer-list>
